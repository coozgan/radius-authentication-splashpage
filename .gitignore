# Ignore log files and sensitive data
*.log
*.json
# ...but not the manifest: the blanket *.json above is aimed at log dumps
# (lambda_log.json, webhook_log.json) and was also hiding package.json, so the
# `npm test` entrypoint could never be committed.
!package.json
webhook_log.txt
lambda_log.json
webhook_log.json
server.log
.env
# Node modules
node_modules/
# Ignore Docker secrets if any
secrets.env
# Ignore VSCode settings
.vscode/

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
**/.terraform.lock.hcl
.terraform
.terraform.lock.hcl


# macOS
.DS_Store
**/.DS_Store
